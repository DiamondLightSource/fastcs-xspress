{
  "$defs": {
    "EpicsCAOptions": {
      "additionalProperties": false,
      "description": "Channel-Access-specific options.\n\nCurrently empty: present so ``epicsca:`` survives in fastcs.yaml as the\ntransport discriminator key. Reserved for future CA-specific knobs.",
      "properties": {
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        }
      },
      "title": "EpicsCAOptions",
      "type": "object"
    },
    "EpicsCATransport": {
      "additionalProperties": false,
      "description": "Channel access transport.",
      "properties": {
        "epicsca": {
          "$ref": "#/$defs/EpicsCAOptions"
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsDocsOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gui": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsGUIOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EpicsCATransport",
      "type": "object"
    },
    "EpicsDocsOptions": {
      "additionalProperties": false,
      "description": "Docs options for EPICS.",
      "properties": {
        "output_dir": {
          "default": ".",
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "title": {
          "default": "FastCS Devices",
          "title": "Title",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        }
      },
      "title": "EpicsDocsOptions",
      "type": "object"
    },
    "EpicsGUIFormat": {
      "description": "The format of an EPICS GUI.",
      "enum": [
        ".bob",
        ".edl"
      ],
      "title": "EpicsGUIFormat",
      "type": "string"
    },
    "EpicsGUIOptions": {
      "additionalProperties": false,
      "description": "Epics GUI options for use in both CA and PVA transports.",
      "properties": {
        "output_dir": {
          "default": ".",
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "file_format": {
          "$ref": "#/$defs/EpicsGUIFormat",
          "default": ".bob"
        },
        "title": {
          "default": "FastCS Devices",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "EpicsGUIOptions",
      "type": "object"
    },
    "EpicsPVAOptions": {
      "additionalProperties": false,
      "description": "PVAccess-specific options.\n\nCurrently empty: present so ``epicspva:`` survives in fastcs.yaml as the\ntransport discriminator key. Reserved for future PVA-specific knobs.",
      "properties": {},
      "title": "EpicsPVAOptions",
      "type": "object"
    },
    "EpicsPVATransport": {
      "additionalProperties": false,
      "description": "PV access transport.",
      "properties": {
        "epicspva": {
          "$ref": "#/$defs/EpicsPVAOptions"
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsDocsOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gui": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsGUIOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EpicsPVATransport",
      "type": "object"
    },
    "IPConnectionSettings": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "default": "127.0.0.1",
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "default": 25565,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "IPConnectionSettings",
      "type": "object"
    },
    "RestServerOptions": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8080,
          "title": "Port",
          "type": "integer"
        },
        "log_level": {
          "default": "info",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "RestServerOptions",
      "type": "object"
    },
    "RestTransport": {
      "additionalProperties": false,
      "description": "Rest Transport Adapter.",
      "properties": {
        "rest": {
          "$ref": "#/$defs/RestServerOptions"
        }
      },
      "title": "RestTransport",
      "type": "object"
    },
    "XspressControllerEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "fastcs_xspress.XspressController",
          "title": "Type",
          "type": "string"
        },
        "connection_settings": {
          "$ref": "#/$defs/IPConnectionSettings"
        }
      },
      "required": [
        "id",
        "type",
        "connection_settings"
      ],
      "title": "XspressControllerEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "controllers": {
      "items": {
        "$ref": "#/$defs/XspressControllerEntry"
      },
      "title": "Controllers",
      "type": "array"
    },
    "transport": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EpicsCATransport"
          },
          {
            "$ref": "#/$defs/EpicsPVATransport"
          },
          {
            "$ref": "#/$defs/RestTransport"
          }
        ]
      },
      "title": "Transport",
      "type": "array"
    }
  },
  "required": [
    "controllers",
    "transport"
  ],
  "title": "XspressController",
  "type": "object"
}
